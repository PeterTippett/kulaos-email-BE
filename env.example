# Copy this file to .env and fill in your values

# GCP
PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=../service-account-key.json

# KMS
KMS_LOCATION=global
KMS_KEYRING=email-service-keyring

# BigQuery
BIGQUERY_LOCATION=australia-southeast1

# Kinde
KINDE_DOMAIN=your-tenant.kinde.com
KINDE_CLIENT_ID=your-kinde-client-id
KINDE_CLIENT_SECRET=your-kinde-client-secret

# Gmail
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-secret

# Backend
BACKEND_PORT=8085
BACKEND_BASE_URL=https://xxxxxx.ngrok-free.app

# Frontend
FRONTEND_BASE_URL=http://localhost:3005

# Pub/Sub
PUBSUB_TOPIC=gmail-notifications

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+

# MCP (Model Context Protocol)
MCP_ENABLED=true
MCP_SHARED_KEY=your_shared_secret_key_here

